<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootQiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/quiz_bg"
    tools:context=".ui.fragments.QizzFragment">

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/quizContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="48dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="20:00"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuestionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/btnExit"
                android:layout_marginEnd="12dp"
                android:text="1/15"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:gravity="center"
                android:text="?"
                android:textColor="@color/text_primary"
                android:textSize="38sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="142dp"
            android:layout_marginTop="64dp"
            android:background="@drawable/bg_qizz_question_card"
            android:gravity="center"
            android:padding="18dp"
            android:text="Ai đẹp trai nhất?"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOptionA"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_qizz_option_default"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Thằng đặt câu hỏi này"
            android:textAllCaps="false"
            android:textColor="@color/text_quiz_option"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOptionB"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_qizz_option_default"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Thằng trả lời câu hỏi này"
            android:textAllCaps="false"
            android:textColor="@color/text_quiz_option"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOptionC"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_qizz_option_default"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Shigeo Tokuda"
            android:textAllCaps="false"
            android:textColor="@color/text_quiz_option"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOptionD"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_qizz_option_default"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Độ Mixi"
            android:textAllCaps="false"
            android:textColor="@color/text_quiz_option"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_qizz_check_button"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="Chọn"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/answerNavigation"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnPrevious"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_qizz_circle_button"
                android:gravity="center"
                android:text="←"
                android:textColor="#FFFFFF"
                android:textSize="42sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnNextAnswer"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_qizz_circle_button"
                android:gravity="center"
                android:text="→"
                android:textColor="#FFFFFF"
                android:textSize="42sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/resultContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="72dp"
        android:paddingEnd="16dp"
        android:paddingBottom="56dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnResultExit"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="48sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:background="@drawable/bg_qizz_dark_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="32dp"
            android:paddingEnd="28dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/ivResultImage"
                android:layout_width="190dp"
                android:layout_height="150dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/meme_success" />

            <TextView
                android:id="@+id/tvResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Bạn đã Tây 🤩"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textColor="@color/check_green"
                    android:textSize="42sp" />

                <TextView
                    android:id="@+id/tvCorrectCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="15/15"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="⏱"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/tvResultTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="19:59"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="×"
                    android:textColor="@color/wrong_red_text"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/tvWrongCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0/15"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnReviewAnswers"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_qizz_result_button"
            android:stateListAnimator="@null"
            android:text="Kiểm tra đáp án"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
